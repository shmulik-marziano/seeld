# Supabase — publishable (anon) credentials only. Never put service_role keys here.
# Values are optional locally: the clients in src/integrations/supabase fall back
# to the production publishable credentials when these are unset.
VITE_SUPABASE_PROJECT_ID=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_SUPABASE_URL=

# The public site runs on the same project and the same client instance as the
# agent app, so the old VITE_SITE_SUPABASE_* trio is gone — setting them did
# nothing except spawn a second auth client that fought over the session.
